# Normalize line endings
* text=auto

# Source files: LF endings everywhere
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Jupyter notebooks
*.ipynb text eol=lf
*.ipynb diff=json linguist-language=JSON

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary